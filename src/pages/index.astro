---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Dropdown from "../components/Dropdown.astro";
import { POST_CATEGORIES } from "../content.config";
import { getCommunityMonth } from "../lib/format";

import { getDisplayEntries, getSearchTitle } from "../lib/post-topics";

const originalPosts = await getCollection("posts");
const posts = getDisplayEntries(originalPosts);

// Fetch view counts for all posts at build time
const viewCounts: Record<string, number> = {};
try {
  await Promise.all(
    posts.map(async (post) => {
      const path = `/digest-showcase/posts/${post.id}`;
      const encoded = encodeURIComponent(path);
      const res = await fetch(
        `https://claude-taiwan.goatcounter.com/counter/${encoded}.json`,
      );
      const data = res.ok ? await res.json() : null;
      viewCounts[post.id] = data ? parseInt(data.count) || 0 : 0;
    }),
  );
} catch (e) {
  console.warn("Failed to fetch view counts at build time:", e);
}

const postsByMonth: Record<string, typeof posts> = {};
for (const post of posts) {
  const ym = getCommunityMonth(post.data.date);
  if (!postsByMonth[ym]) {
    postsByMonth[ym] = [];
  }
  postsByMonth[ym].push(post);
}

const sortedMonths = Object.keys(postsByMonth).sort().reverse();

const ALL_FILTER = "全部";
const POST_TYPE_FILTERS = [
  { label: "留言精華", value: "discussion" },
  { label: "常見問題", value: "qa" },
];
const filters = [ALL_FILTER, ...POST_CATEGORIES];

const FILTER_ICONS: Record<string, string> = {
  全部: "grid_view",
  知識精華: "lightbulb",
  社群活動: "groups",
  留言精華: "forum",
  常見問題: "help",
};

const uniqueAuthors = [...new Set(posts.map((p) => p.data.author))].sort();
const uniqueMonths = sortedMonths;

function formatMonth(ym: string): string {
  const [y, m] = ym.split("-");
  return `${y} 年 ${parseInt(m)} 月`;
}

const authorOptions = uniqueAuthors.map((author) => ({
  label: author,
  value: author,
}));
const dateOptions = uniqueMonths.map((ym) => ({
  label: formatMonth(ym),
  value: ym,
}));
---

<BaseLayout
  title="Claude Taiwan 社團精華展示櫃"
  description="精選 Claude Taiwan Facebook 社團的知識精華與社群活動分享。"
>
  <section class="container intro">
    <h2 class="intro__heading">精華展示櫃</h2>
    <p class="intro__lead">
      收藏 Claude Taiwan 社團裡值得一看再看的分享 —— 從 AI
      協作開發、工具實作到社群活動紀錄。
    </p>

    <div class="filter-bar">
      <!-- Search input: full width row -->
      <div class="search-row">
        <div class="search-input">
          <span
            class="material-symbols-outlined search-input__icon"
            aria-hidden="true">search</span
          >
          <input
            type="text"
            id="title-search"
            class="search-input__field focus-ring"
            placeholder="搜尋標題…"
            autocomplete="off"
          />
          <button
            type="button"
            id="search-clear-btn"
            class="search-input__clear"
            aria-label="清空搜尋內容"
            hidden
          >
            <span class="material-symbols-outlined" aria-hidden="true"
              >close</span
            >
          </button>
        </div>
      </div>
      <!-- Filters row: chips + dropdowns + view toggle -->
      <div class="filters-row">
        <div class="filters" role="group" aria-label="依分類或作者身分篩選">
          {
            filters.map((filter, index) => (
              <button
                type="button"
                class="filter-chip"
                class:list={[{ "filter-chip--active": index === 0 }]}
                data-filter={filter}
                data-filter-type="category"
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {FILTER_ICONS[filter] && (
                  <span
                    class="material-symbols-outlined filter-chip__icon"
                    aria-hidden="true"
                  >
                    {FILTER_ICONS[filter]}
                  </span>
                )}
                {filter}
              </button>
            ))
          }
          {
            POST_TYPE_FILTERS.map((pt) => (
              <button
                type="button"
                class="filter-chip"
                data-filter={pt.value}
                data-filter-type="postType"
                aria-pressed="false"
              >
                <span
                  class="material-symbols-outlined filter-chip__icon"
                  aria-hidden="true"
                >
                  {FILTER_ICONS[pt.label]}
                </span>
                {pt.label}
              </button>
            ))
          }
          <button
            type="button"
            class="filter-chip"
            data-filter="true"
            data-filter-type="ambassador"
            aria-pressed="false"
          >
            <span
              class="material-symbols-outlined filter-chip__icon"
              aria-hidden="true">verified</span
            >
            Claude Ambassador
          </button>
        </div>

        <!-- Author combobox -->
        <Dropdown
          id="author-dropdown"
          icon="person"
          defaultLabel="所有作者"
          showSearch={true}
          options={authorOptions}
        />

        <!-- Date dropdown -->
        <Dropdown
          id="date-dropdown"
          icon="calendar_month"
          defaultLabel="所有日期"
          options={dateOptions}
        />

        <!-- Clear Filters button -->
        <button
          type="button"
          id="clear-filters-btn"
          class="clear-filters-btn focus-ring"
          disabled
        >
          <span
            class="material-symbols-outlined clear-filters-btn__icon"
            aria-hidden="true">filter_alt_off</span
          >
          清除條件
        </button>

        <div class="view-toggle" role="group" aria-label="切換顯示模式">
          <button
            type="button"
            class="view-toggle__btn view-toggle__btn--active"
            data-view="grid"
            aria-pressed="true"
          >
            <span class="material-symbols-outlined" aria-hidden="true"
              >grid_view</span
            >
          </button>
          <button
            type="button"
            class="view-toggle__btn"
            data-view="list"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined" aria-hidden="true"
              >view_list</span
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Subtle Adblock Warning Notice (hidden by default) -->
  <div id="adblock-notice" class="adblock-notice container">
    <span class="material-symbols-outlined" aria-hidden="true">info</span>
    <span>
      由於廣告阻擋器，目前已自動切換為靜態統計。
      <a href="#" id="adblock-help-trigger">了解如何恢復即時統計...</a>
    </span>
  </div>

  <section class="container" id="post-sections">
    {
      sortedMonths.map((ym) => (
        <div class="month-section" data-month={ym}>
          <h3 class="month-section__title">
            <span class="material-symbols-outlined" aria-hidden="true">
              calendar_today
            </span>
            {formatMonth(ym)}
          </h3>
          <div class="grid post-grid">
            {postsByMonth[ym].map((post, index) => (
              <div
                class="reveal"
                style={`--i: ${index}`}
                data-title={getSearchTitle(post, originalPosts).toLowerCase()}
                data-author={post.data.author}
                data-date={ym}
              >
                <PostCard
                  post={post}
                  buildTimeViewCount={viewCounts[post.id] || 0}
                />
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <p class="empty" id="empty-state" hidden>目前沒有符合條件的貼文。</p>
  </section>

  <!-- Adblock Help Modal -->
  <dialog id="adblock-modal" class="adblock-modal">
    <div class="adblock-modal__content">
      <header class="adblock-modal__header">
        <h2 class="adblock-modal__title">為什麼看不到即時統計？</h2>
        <button
          type="button"
          class="adblock-modal__close"
          id="adblock-modal-close"
          aria-label="關閉"
        >
          <span class="material-symbols-outlined" aria-hidden="true">close</span
          >
        </button>
      </header>
      <div class="adblock-modal__body">
        <p>
          本展示櫃使用 <a
            href="https://www.goatcounter.com"
            target="_blank"
            rel="noopener noreferrer">GoatCounter</a
          > 統計非私人的匿名瀏覽數據。
        </p>
        <p>
          由於 GoatCounter 屬於網站分析（Analytics）服務，多數<strong
            >廣告阻擋器</strong
          >（例如 uBlock Origin、AdBlock Plus、Brave 瀏覽器內建 Shields、Safari
          內容阻擋等）會自動將其網域阻擋，這會阻礙即時瀏覽數的加載與更新。
        </p>
        <p>
          為了確保您可以流暢瀏覽，本站採用了<strong>預渲染備用技術</strong
          >，即便被阻擋，您仍能看見建置時的靜態閱讀次數。若您希望看到最即時的數據更新，請考慮在廣告阻擋器中將本站加入白名單，或新增自訂排除規則：
        </p>
        <pre
          style="background: var(--color-border); padding: 12px; border-radius: 6px; font-family: monospace; font-size: 0.88rem; margin: 8px 0; overflow-x: auto;"><code>@@||claude-taiwan.goatcounter.com^
@@||gc.zgo.at^</code></pre>
        <p style="margin-top: 12px;">
          設定完成並重新整理網頁後，系統即會開始即時同步最新的數據。
        </p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .intro {
    padding-top: 40px;
  }

  .intro__heading {
    margin: 0 0 8px;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .intro__lead {
    margin: 0 0 24px;
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 18px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .filter-chip__icon {
    font-size: 16px;
  }

  .filter-chip--active .filter-chip__icon {
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 20;
  }

  .filter-chip:hover:not(.filter-chip--active) {
    color: var(--color-text);
    border-color: var(--color-primary-light);
  }

  .filter-chip--active:hover {
    background: var(--color-primary-dark);
  }

  .filter-chip--active {
    color: #fff;
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }

  .month-section {
    margin-bottom: 40px;
  }

  .month-section__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .month-section__title .material-symbols-outlined {
    font-size: var(--icon-size-header);
    color: var(--color-primary);
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: 48px 0;
  }

  .view-toggle {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .view-toggle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-family: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-text-muted);
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .view-toggle__btn:hover:not(.view-toggle__btn--active) {
    color: var(--color-text);
    border-color: var(--color-primary-light);
  }

  .view-toggle__btn--active {
    color: #fff;
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .view-toggle__btn--active .material-symbols-outlined {
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 20;
  }

  .view-toggle__btn--active:hover {
    background: var(--color-primary-dark);
  }

  .grid--list {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  /* Search input */
  .search-row {
    width: 100%;
  }

  .search-input {
    position: relative;
    width: 100%;
  }

  .search-input__icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input__field {
    width: 100%;
    padding: 10px 40px 10px 44px;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
    box-sizing: border-box;
  }

  .search-input__field::placeholder {
    color: var(--color-text-muted);
  }

  .search-input__clear {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .search-input__clear:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .search-input__clear[hidden] {
    display: none;
  }

  .clear-filters-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-subtle);
    border: 1px dashed var(--color-primary-light);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .clear-filters-btn:hover:not(:disabled) {
    color: #fff;
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(217, 119, 87, 0.2);
  }

  .clear-filters-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .clear-filters-btn:disabled {
    color: var(--color-text-muted);
    background: transparent;
    border: 1px dashed var(--color-border);
    cursor: not-allowed;
    opacity: 0.5;
  }

  .clear-filters-btn__icon {
    font-size: 16px;
  }

  /* Filters row */
  .filters-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filters-row .view-toggle {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .filters-row {
      gap: 8px;
    }
  }

  /* Adblock Notice */
  .adblock-notice {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 8px 16px;
    display: none; /* JS toggles this to flex */
    margin: 0 auto 24px auto;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 90%;
  }

  .adblock-notice .material-symbols-outlined {
    color: #eab308;
    font-size: 16px;
    flex-shrink: 0;
  }

  .adblock-notice span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .adblock-notice a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .adblock-notice a:hover {
    opacity: 0.75;
  }

  /* Adblock Modal */
  .adblock-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: 500px;
    width: calc(100% - 32px);
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.2),
      0 10px 10px -5px rgba(0, 0, 0, 0.1);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .adblock-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .adblock-modal__content {
    display: flex;
    flex-direction: column;
  }

  .adblock-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .adblock-modal__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .adblock-modal__close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 4px;
    display: flex;
    align-items: center;
    border-radius: 4px;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .adblock-modal__close:hover {
    background: var(--color-border);
    color: var(--color-text);
  }

  .adblock-modal__body {
    padding: 20px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .adblock-modal__body a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .adblock-modal__body a:hover {
    color: var(--color-primary-hover);
  }

  .adblock-modal__body strong {
    color: var(--color-text);
  }
</style>

<script>
  // Unified client-side filtering: category, title search, author, date (AND logic).
  const ALL_FILTER = "全部";
  const ACTIVE_CLASS = "filter-chip--active";

  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const emptyState = document.getElementById("empty-state");
  const titleSearchInput = document.getElementById(
    "title-search",
  ) as HTMLInputElement;
  const searchClearBtn = document.getElementById(
    "search-clear-btn",
  ) as HTMLButtonElement;
  const clearFiltersBtn = document.getElementById(
    "clear-filters-btn",
  ) as HTMLButtonElement;

  // --- Filter state ---
  let activeFilterType: "category" | "postType" | "ambassador" = "category";
  let activeFilterValue = ALL_FILTER;
  let searchQuery = "";
  let selectedAuthor = "";
  let selectedDate = "";

  function applyAllFilters(): void {
    let visibleCount = 0;
    const query = searchQuery.toLowerCase();
    const monthSections =
      document.querySelectorAll<HTMLElement>(".month-section");

    monthSections.forEach((section) => {
      let sectionVisibleCount = 0;
      const wrappers = section.querySelectorAll<HTMLElement>(".reveal");

      wrappers.forEach((wrapper) => {
        const card = wrapper.querySelector<HTMLElement>("[data-category]");
        if (!card) return;

        let matchesFilter = true;
        if (activeFilterType === "category") {
          matchesFilter =
            activeFilterValue === ALL_FILTER ||
            card.dataset.category === activeFilterValue;
        } else if (activeFilterType === "ambassador") {
          matchesFilter = card.dataset.ambassador === "true";
        } else {
          matchesFilter = card.dataset.postType === activeFilterValue;
        }
        const matchesTitle =
          !query || (wrapper.dataset.title?.includes(query) ?? false);
        const matchesAuthor =
          !selectedAuthor || wrapper.dataset.author === selectedAuthor;
        const matchesDate =
          !selectedDate || wrapper.dataset.date === selectedDate;

        const isVisible =
          matchesFilter && matchesTitle && matchesAuthor && matchesDate;
        wrapper.hidden = !isVisible;

        if (isVisible) {
          sectionVisibleCount += 1;
          visibleCount += 1;
          wrapper.style.animation = "none";
          wrapper.offsetHeight; // force reflow
          wrapper.style.animation = "fadeIn 0.3s ease both";
        }
      });

      section.hidden = sectionVisibleCount === 0;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;

    // Toggle search clear button
    if (searchClearBtn) {
      searchClearBtn.hidden = searchQuery === "";
    }

    // Toggle clear all filters button
    if (clearFiltersBtn) {
      const isAnyFilterActive =
        activeFilterValue !== ALL_FILTER ||
        searchQuery !== "" ||
        selectedAuthor !== "" ||
        selectedDate !== "";
      clearFiltersBtn.disabled = !isAnyFilterActive;
    }
  }

  // --- Filter chips (category + postType share the same active group) ---
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((other) => {
        const isActive = other === chip;
        other.classList.toggle(ACTIVE_CLASS, isActive);
        other.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
      activeFilterType =
        (chip.dataset.filterType as "category" | "postType" | "ambassador") ??
        "category";
      activeFilterValue = chip.dataset.filter ?? ALL_FILTER;
      applyAllFilters();
    });
  });

  // --- Title search ---
  titleSearchInput?.addEventListener("input", () => {
    searchQuery = titleSearchInput.value;
    applyAllFilters();
  });

  // --- Search clear button click ---
  searchClearBtn?.addEventListener("click", () => {
    if (titleSearchInput) {
      titleSearchInput.value = "";
      searchQuery = "";
      applyAllFilters();
      titleSearchInput.focus();
    }
  });

  // --- Clear all filters click ---
  function clearAllFilters(): void {
    // 1. Reset state variables
    activeFilterType = "category";
    activeFilterValue = ALL_FILTER;
    searchQuery = "";
    selectedAuthor = "";
    selectedDate = "";

    // 2. Reset title search input
    if (titleSearchInput) {
      titleSearchInput.value = "";
    }

    // 3. Reset filter chips UI
    chips.forEach((chip) => {
      const isAll =
        chip.dataset.filter === ALL_FILTER &&
        chip.dataset.filterType === "category";
      chip.classList.toggle(ACTIVE_CLASS, isAll);
      chip.setAttribute("aria-pressed", isAll ? "true" : "false");
    });

    // 4. Reset Author dropdown UI
    const authorDropdown = document.getElementById("author-dropdown");
    if (authorDropdown) {
      const label =
        authorDropdown.querySelector<HTMLElement>(".dropdown__label");
      if (label) label.textContent = "所有作者";
      const options =
        authorDropdown.querySelectorAll<HTMLElement>(".dropdown__option");
      options.forEach((opt) => {
        const isAll = opt.dataset.value === "";
        opt.classList.toggle("dropdown__option--active", isAll);
        opt.setAttribute("aria-selected", isAll ? "true" : "false");
      });
    }

    // 5. Reset Date dropdown UI
    const dateDropdown = document.getElementById("date-dropdown");
    if (dateDropdown) {
      const label = dateDropdown.querySelector<HTMLElement>(".dropdown__label");
      if (label) label.textContent = "所有日期";
      const options =
        dateDropdown.querySelectorAll<HTMLElement>(".dropdown__option");
      options.forEach((opt) => {
        const isAll = opt.dataset.value === "";
        opt.classList.toggle("dropdown__option--active", isAll);
        opt.setAttribute("aria-selected", isAll ? "true" : "false");
      });
    }

    // 6. Apply filters
    applyAllFilters();
  }

  clearFiltersBtn?.addEventListener("click", clearAllFilters);

  // --- Dropdown logic ---
  function initDropdown(
    containerId: string,
    onSelect: (value: string) => void,
  ): void {
    const container = document.getElementById(containerId);
    if (!container) return;

    const trigger =
      container.querySelector<HTMLButtonElement>(".dropdown__trigger");
    const panel = container.querySelector<HTMLElement>(".dropdown__panel");
    const label = container.querySelector<HTMLElement>(".dropdown__label");
    const options =
      container.querySelectorAll<HTMLElement>(".dropdown__option");
    const searchInput =
      container.querySelector<HTMLInputElement>(".dropdown__search");

    if (!trigger || !panel || !label) return;

    function openPanel(): void {
      panel!.hidden = false;
      trigger!.setAttribute("aria-expanded", "true");
      searchInput?.focus();
    }

    function closePanel(): void {
      panel!.hidden = true;
      trigger!.setAttribute("aria-expanded", "false");
      if (searchInput) searchInput.value = "";
      options.forEach((opt) => {
        opt.hidden = false;
      });
    }

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      // Close other dropdowns first
      document
        .querySelectorAll(".dropdown__trigger[aria-expanded='true']")
        .forEach((other) => {
          if (other !== trigger) {
            const otherPanel = other
              .closest(".dropdown")
              ?.querySelector<HTMLElement>(".dropdown__panel");
            if (otherPanel) otherPanel.hidden = true;
            other.setAttribute("aria-expanded", "false");
          }
        });
      if (isOpen) {
        closePanel();
      } else {
        openPanel();
      }
    });

    panel.addEventListener("click", (e) => {
      e.stopPropagation();
    });

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const value = opt.dataset.value ?? "";
        options.forEach((o) => {
          const isActive = o === opt;
          o.classList.toggle("dropdown__option--active", isActive);
          o.setAttribute("aria-selected", isActive ? "true" : "false");
        });
        label!.textContent = opt.textContent?.trim() ?? "";
        onSelect(value);
        closePanel();
      });
    });

    // Inline search within dropdown
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const q = searchInput.value.toLowerCase();
        options.forEach((opt) => {
          // "所有作者"/"所有日期" (empty value) always visible
          if (!opt.dataset.value) {
            opt.hidden = false;
            return;
          }
          opt.hidden = !(opt.textContent?.toLowerCase().includes(q) ?? false);
        });
      });

      searchInput.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    }
  }

  initDropdown("author-dropdown", (value) => {
    selectedAuthor = value;
    applyAllFilters();
  });

  initDropdown("date-dropdown", (value) => {
    selectedDate = value;
    applyAllFilters();
  });

  // Close dropdowns on outside click
  document.addEventListener("click", () => {
    document
      .querySelectorAll<HTMLElement>(".dropdown__panel:not([hidden])")
      .forEach((panel) => {
        panel.hidden = true;
        const trigger = panel
          .closest(".dropdown")
          ?.querySelector<HTMLElement>(".dropdown__trigger");
        if (trigger) trigger.setAttribute("aria-expanded", "false");
        const search =
          panel.querySelector<HTMLInputElement>(".dropdown__search");
        if (search) search.value = "";
        panel
          .querySelectorAll<HTMLElement>(".dropdown__option")
          .forEach((opt) => {
            opt.hidden = false;
          });
      });
  });

  // --- Scroll reveal ---
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document
    .querySelectorAll(".reveal")
    .forEach((el) => revealObserver.observe(el));

  // --- View toggle ---
  const VIEW_ACTIVE_CLASS = "view-toggle__btn--active";
  const LIST_CLASS = "grid--list";
  const VIEW_STORAGE_KEY = "digest-view-mode";

  const viewBtns =
    document.querySelectorAll<HTMLButtonElement>(".view-toggle__btn");
  const postGrids = document.querySelectorAll(".post-grid");

  function setView(mode: string): void {
    viewBtns.forEach((btn) => {
      const isActive = btn.dataset.view === mode;
      btn.classList.toggle(VIEW_ACTIVE_CLASS, isActive);
      btn.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
    postGrids.forEach((grid) => {
      grid.classList.toggle(LIST_CLASS, mode === "list");
    });
  }

  const savedView = localStorage.getItem(VIEW_STORAGE_KEY);
  if (savedView === "list") setView("list");

  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.dataset.view ?? "grid";
      setView(mode);
      localStorage.setItem(VIEW_STORAGE_KEY, mode);
    });
  });

  // Fetch view counts for cards
  const cards = document.querySelectorAll<HTMLElement>(".card__views");
  const adblockNotice = document.getElementById("adblock-notice");
  const adblockModal = document.getElementById(
    "adblock-modal",
  ) as HTMLDialogElement | null;
  const adblockTrigger = document.getElementById("adblock-help-trigger");
  const adblockClose = document.getElementById("adblock-modal-close");

  let adblockDetected = false;

  if (cards.length > 0) {
    const promises = Array.from(cards).map((el) => {
      const path = el.dataset.viewPath;
      if (!path) return Promise.resolve();
      const encoded = encodeURIComponent(path);
      return fetch(
        `https://claude-taiwan.goatcounter.com/counter/${encoded}.json`,
      )
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (data?.count != null) {
            el.querySelector(".card__view-count")!.textContent = data.count;
          }
        })
        .catch(() => {
          adblockDetected = true;
        });
    });

    Promise.all(promises).then(() => {
      if (adblockDetected && adblockNotice) {
        adblockNotice.style.display = "flex";
      }
    });
  }

  // Adblock Help Modal Logic
  if (adblockModal && adblockClose) {
    if (adblockTrigger) {
      adblockTrigger.addEventListener("click", (e) => {
        e.preventDefault();
        adblockModal.showModal();
      });
    }
    adblockClose.addEventListener("click", () => {
      adblockModal.close();
    });
    adblockModal.addEventListener("click", (e) => {
      if (e.target === adblockModal) {
        adblockModal.close();
      }
    });
  }
</script>
