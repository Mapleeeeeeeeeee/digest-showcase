---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AmbassadorBadge from "../../components/AmbassadorBadge.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import PostStats from "../../components/PostStats.astro";
import PostMedia from "../../components/PostMedia.astro";
import { formatDateZh } from "../../lib/format";
import { buildUrl, authorUrl, postUrl } from "../../lib/url";
import BackLink from "../../components/BackLink.astro";
import PostNavigation from "../../components/PostNavigation.astro";
import TopicSource from "../../components/TopicSource.astro";
import PostResources from "../../components/PostResources.astro";
import {
  getDisplayEntries,
  getPostTopic,
  getTopicSources,
  sourceAnchor,
} from "../../lib/post-topics";
import Lightbox from "../../components/Lightbox.astro";

const laptopSrc = buildUrl("/clawd-laptop.json");

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const displayPosts = getDisplayEntries(posts);
  const topicSources = getTopicSources(posts);
  return posts.map((post) => {
    const topic = getPostTopic(post.id);
    const displayId = topic?.primaryId ?? post.id;
    const index = displayPosts.findIndex((entry) => entry.id === displayId);
    return {
      params: { id: post.id },
      props: {
        post,
        topicSources: topic ? topicSources : [],
        prevPost:
          index < displayPosts.length - 1 ? displayPosts[index + 1] : null,
        nextPost: index > 0 ? displayPosts[index - 1] : null,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post, prevPost, nextPost, topicSources } = Astro.props;
const topic = getPostTopic(post.id);
if (topic && post.id !== topic.primaryId) {
  return Astro.redirect(
    `${postUrl(topic.primaryId)}#${sourceAnchor(post.id)}`,
    301,
  );
}
const pageTitle = topic?.title ?? post.data.title;
const { data } = post;
const { Content } = await render(post);

// Fetch view count at build time
let buildTimeViewCount = 0;
try {
  const path = `/digest-showcase/posts/${post.id}`;
  const encoded = encodeURIComponent(path);
  const res = await fetch(
    `https://claude-taiwan.goatcounter.com/counter/${encoded}.json`,
  );
  const data = res.ok ? await res.json() : null;
  buildTimeViewCount = data ? parseInt(data.count) || 0 : 0;
} catch (e) {
  console.warn("Failed to fetch view count at build time:", e);
}

const formattedDate = formatDateZh(data.date);

function linkify(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(
      /(https?:\/\/[^\s<]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>',
    )
    .replace(/\n/g, "<br>");
}
const homeHref = buildUrl("/");
const authorHref = authorUrl(data.authorId);
---

<BaseLayout title={`${pageTitle} · Claude Taiwan 社團精華展示櫃`}>
  <article class="container post">
    <BackLink href={homeHref} />

    <header class="post__header">
      <div class="post__badges">
        <CategoryBadge category={data.category} />
        <AmbassadorBadge authorId={data.authorId} />
        {
          data.postType === "discussion" && (
            <span class="badge-discussion">
              <span class="material-symbols-outlined">forum</span>
              留言精華
            </span>
          )
        }
        {
          data.postType === "qa" && (
            <span class="badge-qa">
              <span class="material-symbols-outlined">help</span>
              常見問題
            </span>
          )
        }
        {data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
      <h1 class="post__title">{pageTitle}</h1>
      <p class="post__meta">
        <a href={authorHref} class="author-link">
          {data.author}
        </a> · {topic && "最新分享 "}{formattedDate}
      </p>
      {
        topic && (
          <p class="post__meta">
            2 篇原文 · 以下為最新分享的互動數，各篇數字見原文段落。
          </p>
        )
      }
      <div class="post__stats">
        <PostStats
          likes={data.likes}
          comments={data.comments}
          shares={data.shares}
        />
        <span class="stats__item stats__item--views" title="瀏覽">
          <span class="material-symbols-outlined stats__icon" aria-hidden="true"
            >visibility</span
          >
          <span class="visually-hidden">瀏覽 </span><span id="view-count"
            >{buildTimeViewCount}</span
          >
          <span
            id="adblock-info-container"
            class="views-help-container"
            style="display: none;"
          >
            <span class="material-symbols-outlined adblock-info-icon">info</span
            >
            <span class="views-tooltip"
              >偵測到廣告阻擋器。目前顯示為建置時的備用靜態數據。</span
            >
          </span>
        </span>
        <button class="share-btn" id="share-btn" type="button" title="分享文章">
          <span class="material-symbols-outlined">share</span>
          <span class="share-btn__label">分享</span>
        </button>
      </div>
    </header>

    {
      topic ? (
        <>
          <PostResources posts={topicSources} />
          <nav aria-label="主題原文">
            {topicSources.map((source) => (
              <p>
                <a href={`#${sourceAnchor(source.id)}`}>
                  {formatDateZh(source.data.date)} · {source.data.title}
                </a>
              </p>
            ))}
          </nav>
          {topicSources.map((source) => (
            <TopicSource post={source} />
          ))}
        </>
      ) : (
        <>
          <PostResources posts={[post]} />
          <div class="post__body">
            <Content />
          </div>

          {(data.postType === "discussion" || data.postType === "qa") &&
            data.highlights.length > 0 && (
              <section class="post__highlights">
                {data.highlights
                  .filter((h) => h.isBestAnswer)
                  .map((h) => (
                    <div class="highlight highlight--best">
                      <div class="highlight__label">
                        <span class="material-symbols-outlined">
                          check_circle
                        </span>
                        最佳解答
                      </div>
                      <div class="highlight__author">{h.author}</div>
                      <div class="highlight__text" set:html={linkify(h.text)} />
                      <div class="highlight__likes">
                        <span class="material-symbols-outlined">favorite</span>
                        {h.likes}
                      </div>
                    </div>
                  ))}

                {data.highlights.filter((h) => !h.isBestAnswer).length > 0 && (
                  <div class="highlight__others-label">其他留言</div>
                )}

                {data.highlights
                  .filter((h) => !h.isBestAnswer)
                  .map((h) => (
                    <div class="highlight highlight--other">
                      <div class="highlight__other-header">
                        <span class="highlight__author">{h.author}</span>
                        <span class="highlight__likes">
                          <span class="material-symbols-outlined">
                            favorite
                          </span>
                          {h.likes}
                        </span>
                      </div>
                      <div class="highlight__text" set:html={linkify(h.text)} />
                    </div>
                  ))}
              </section>
            )}

          <PostMedia
            title={data.title}
            images={data.images}
            videos={data.videos}
          />

          <div class="post__source">
            <a
              href={data.sourceUrl}
              class="source-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="source-link__lottie" data-lottie-src={laptopSrc} />
              前往原文討論
            </a>
          </div>
        </>
      )
    }
    <PostNavigation prevPost={prevPost} nextPost={nextPost} />
  </article>

  <Lightbox />
</BaseLayout>

<script>
  // Share button
  const shareBtn = document.getElementById("share-btn");
  if (shareBtn) {
    shareBtn.addEventListener("click", async () => {
      const shareData = { title: document.title, url: window.location.href };

      // 1. Always copy link to clipboard (non-blocking to preserve user activation for navigator.share)
      navigator.clipboard
        .writeText(window.location.href)
        .then(() => showToast("已複製連結"))
        .catch(() => {});

      // 2. Trigger native share if available
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch {}
      }
    });
  }

  function showToast(msg: string): void {
    let toast = document.getElementById("toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "toast";
      toast.className = "toast";
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add("toast--visible");
    setTimeout(() => toast!.classList.remove("toast--visible"), 2000);
  }

  // Fetch view count from GoatCounter
  const viewCountEl = document.getElementById("view-count");

  if (viewCountEl) {
    const path = encodeURIComponent(window.location.pathname);
    fetch(`https://claude-taiwan.goatcounter.com/counter/${path}.json`)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (data?.count != null) {
          viewCountEl.textContent = data.count;
        }
      })
      .catch(() => {
        // If fetch fails (adblocker), show the pre-defined tooltip container
        const container = document.getElementById("adblock-info-container");
        if (container) {
          container.style.display = "inline-flex";
        }
      });
  }
</script>

<style>
  .post {
    max-width: 760px;
    padding-top: 32px;
  }

  .post__header {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 28px;
  }

  .post__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .tag {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  .post__title {
    margin: 0 0 12px;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    font-weight: 800;
    line-height: 1.4;
  }

  .post__meta {
    margin: 0 0 14px;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .author-link {
    color: var(--color-primary);
    font-weight: 600;
  }

  .author-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post__stats {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .stats__item--views {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .stats__item--views .stats__icon {
    font-size: 16px;
    opacity: 0.8;
  }

  .post__body {
    font-size: 1.02rem;
    color: var(--color-text);
  }

  .post__body :global(p) {
    margin: 0 0 1.1em;
  }

  .post__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post__source {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .source-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: var(--color-surface);
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 12px 28px 14px;
    border-radius: var(--radius-lg);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
    box-shadow: 0 4px 14px rgba(217, 119, 87, 0.15);
  }

  .source-link:hover {
    transform: translateY(-2px);
    background: var(--color-primary-subtle);
    box-shadow: 0 8px 22px rgba(217, 119, 87, 0.25);
  }

  .source-link__lottie {
    display: block;
    width: 72px;
    height: 72px;
  }

  /* Discussion / QA badges */
  .badge-discussion,
  .badge-qa {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  .badge-discussion .material-symbols-outlined,
  .badge-qa .material-symbols-outlined {
    font-size: var(--icon-size-meta);
  }

  .badge-discussion {
    color: #1565c0;
    background: #e3f2fd;
  }

  .badge-qa {
    color: #e65100;
    background: #fff3e0;
  }

  /* Comment highlights */
  .post__highlights {
    margin: 32px 0;
  }

  .highlight--best {
    background: #e8f5e9;
    border: 1px solid #a5d6a7;
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 20px;
  }

  .highlight__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #2e7d32;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 10px;
  }

  .highlight__label .material-symbols-outlined {
    font-size: var(--icon-size-button);
  }

  .highlight--best .highlight__author {
    font-weight: 700;
    font-size: 0.95rem;
    color: #2e7d32;
    margin-bottom: 8px;
  }

  .highlight--best .highlight__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .highlight--best .highlight__likes {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.82rem;
    color: #2e7d32;
  }

  .highlight--best .highlight__likes .material-symbols-outlined {
    font-size: var(--icon-size-body);
  }

  .highlight__others-label {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  .highlight--other {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .highlight--other:last-child {
    border-bottom: none;
  }

  .highlight__other-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .highlight--other .highlight__author {
    font-weight: 600;
    font-size: 0.88rem;
  }

  .highlight--other .highlight__likes {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .highlight--other .highlight__likes .material-symbols-outlined {
    font-size: var(--icon-size-meta);
  }

  .highlight--other .highlight__text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .highlight__text :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    font-family: inherit;
    margin-left: auto;
  }

  .share-btn .material-symbols-outlined {
    font-size: var(--icon-size-button);
  }

  .share-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary-light);
  }

  .adblock-info-icon {
    margin-left: 4px;
    font-size: 14px;
    cursor: pointer;
    color: #eab308;
    vertical-align: middle;
  }

  .views-help-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .views-tooltip {
    visibility: hidden;
    position: absolute;
    bottom: 135%;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    text-align: center;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    line-height: 1.4;
    white-space: nowrap;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    z-index: 10;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      visibility 0.15s ease;
  }

  /* Tooltip Arrow */
  .views-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: var(--color-border) transparent transparent transparent;
  }

  .views-help-container:hover .views-tooltip {
    visibility: visible;
    opacity: 1;
  }
</style>

<style is:global>
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(16px);
    background: var(--color-text, #141413);
    color: #fff;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;
    z-index: 10000;
    pointer-events: none;
  }

  .toast--visible {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
</style>
