---
interface Option {
  label: string;
  value: string;
}

interface Props {
  id: string;
  icon: string;
  defaultLabel: string;
  showSearch?: boolean;
  options: Option[];
}

const { id, icon, defaultLabel, showSearch = false, options } = Astro.props;
---

<div class="dropdown" id={id}>
  <button
    type="button"
    class="dropdown__trigger"
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <span class="material-symbols-outlined dropdown__icon" aria-hidden="true"
      >{icon}</span
    >
    <span class="dropdown__label">{defaultLabel}</span>
    <span class="material-symbols-outlined dropdown__chevron" aria-hidden="true"
      >expand_more</span
    >
  </button>
  <div class="dropdown__panel" hidden>
    {
      showSearch && (
        <div class="dropdown__search-wrap">
          <input
            type="text"
            class="dropdown__search focus-ring"
            placeholder="搜尋…"
            autocomplete="off"
          />
        </div>
      )
    }
    <ul class="dropdown__list" role="listbox">
      <li
        class="dropdown__option dropdown__option--active"
        role="option"
        data-value=""
        aria-selected="true"
      >
        {defaultLabel}
      </li>
      {
        options.map((opt) => (
          <li
            class="dropdown__option"
            role="option"
            data-value={opt.value}
            aria-selected="false"
          >
            {opt.label}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* Dropdown (combobox) */
  .dropdown {
    position: relative;
  }

  .dropdown__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
    white-space: nowrap;
  }

  .dropdown__trigger:hover {
    color: var(--color-text);
    border-color: var(--color-primary-light);
  }

  .dropdown__trigger[aria-expanded="true"] {
    color: #fff;
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .dropdown__icon {
    font-size: 16px;
  }

  .dropdown__trigger[aria-expanded="true"] .dropdown__icon {
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 20;
  }

  .dropdown__chevron {
    font-size: 18px;
    transition: transform 0.2s ease;
  }

  .dropdown__trigger[aria-expanded="true"] .dropdown__chevron {
    transform: rotate(180deg);
  }

  .dropdown__label {
    line-height: 1;
  }

  .dropdown__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 200px;
    max-height: 280px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    z-index: 100;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .dropdown__panel[hidden] {
    display: none;
  }

  .dropdown__search-wrap {
    padding: 8px 8px 4px;
  }

  .dropdown__search {
    width: 100%;
    padding: 7px 12px;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s ease;
    box-sizing: border-box;
  }

  .dropdown__search::placeholder {
    color: var(--color-text-muted);
  }

  .dropdown__list {
    list-style: none;
    margin: 0;
    padding: 4px;
    overflow-y: auto;
    max-height: 220px;
  }

  .dropdown__option {
    padding: 8px 12px;
    font-size: 0.85rem;
    color: var(--color-text);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.1s ease;
  }

  .dropdown__option:hover {
    background: var(--color-primary-subtle);
  }

  .dropdown__option--active {
    color: var(--color-primary);
    font-weight: 600;
    background: var(--color-primary-subtle);
  }

  .dropdown__option[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
    .dropdown__panel {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      border-radius: 16px 16px 0 0;
      max-height: 50vh;
    }
  }
</style>
