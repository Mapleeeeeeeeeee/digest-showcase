---
import type { CollectionEntry } from "astro:content";
import { postUrl } from "../lib/url";

interface Props {
  prevPost: CollectionEntry<"posts"> | null;
  nextPost: CollectionEntry<"posts"> | null;
}

const { prevPost, nextPost } = Astro.props;
---

{
  (prevPost || nextPost) && (
    <nav class="post-nav" aria-label="文章導覽">
      <div class="post-nav__link-wrapper">
        {prevPost ? (
          <a
            href={postUrl(prevPost.id)}
            class="post-nav__link post-nav__link--prev"
          >
            <span class="post-nav__label">
              <span class="material-symbols-outlined" aria-hidden="true">
                arrow_back
              </span>
              上一篇
            </span>
            <span class="post-nav__title">{prevPost.data.title}</span>
          </a>
        ) : (
          <div class="post-nav__link post-nav__link--disabled">
            <span class="post-nav__label">沒有更早的文章了</span>
          </div>
        )}
      </div>

      <div class="post-nav__separator" />

      <div class="post-nav__link-wrapper">
        {nextPost ? (
          <a
            href={postUrl(nextPost.id)}
            class="post-nav__link post-nav__link--next"
          >
            <span class="post-nav__label">
              下一篇
              <span class="material-symbols-outlined" aria-hidden="true">
                arrow_forward
              </span>
            </span>
            <span class="post-nav__title">{nextPost.data.title}</span>
          </a>
        ) : (
          <div class="post-nav__link post-nav__link--disabled">
            <span class="post-nav__label">這是最新的一篇文章</span>
          </div>
        )}
      </div>
    </nav>
  )
}

<style>
  /* Post navigation */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    align-items: stretch;
  }

  .post-nav__link-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
    height: 100%;
    box-sizing: border-box;
    text-decoration: none;
  }

  .post-nav__link:hover {
    border-color: var(--color-primary-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .post-nav__link--prev {
    align-items: flex-start;
  }

  .post-nav__link--next {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav__link--disabled {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    height: 100%;
    opacity: 0.6;
    box-sizing: border-box;
  }

  .post-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .post-nav__link:hover .post-nav__label {
    color: var(--color-primary);
  }

  .post-nav__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .post-nav__separator {
    width: 1px;
    background: var(--color-border);
    align-self: stretch;
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .post-nav__separator {
      display: none;
    }
  }
</style>
